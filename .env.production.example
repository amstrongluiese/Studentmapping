# ==============================================================================
# Studentmapping GIS — Production Environment Template
# Copy to `.env` on your production host / secrets manager. NEVER commit real secrets.
# ==============================================================================

NODE_ENV=production
PORT=5000

# MySQL 8.4+ Production Database (use TLS/SSL in managed cloud MySQL: ?ssl={"rejectUnauthorized":true})
MYSQL_URL=mysql://studentmapping_prod:CHANGE_ME@prod-db-host:3306/student_mapping
DATABASE_URL=mysql://studentmapping_prod:CHANGE_ME@prod-db-host:3306/student_mapping

# Docker Compose MySQL credentials (if self-hosting with docker-compose.yml)
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PROD_ROOT_PASSWORD
MYSQL_DATABASE=student_mapping
MYSQL_USER=studentmapping_prod
MYSQL_PASSWORD=CHANGE_ME_STRONG_PROD_APP_PASSWORD

# Redis Caching Tier
REDIS_URL=redis://redis:6379

# Required Security Secrets (REQUIRED in production — app fails fast if missing or < 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_PROD_SESSION_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_PROD_ENCRYPTION_KEY

# Strict CORS/CSRF Origin Allowlist (exact HTTPS domain, no trailing slash)
CORS_ORIGIN=https://gis.yourdomain.edu.ph

# Must ALWAYS be false in production
ALLOW_DEV_AUTO_ADMIN=false

# Reverse Proxy, MySQL Pool & Background Worker Tuning
TRUST_PROXY=1
MYSQL_POOL_LIMIT=20
MYSQL_QUEUE_LIMIT=0
MYSQL_CONNECT_TIMEOUT_MS=10000
QUEUE_CONCURRENCY=2

# Observability & Error Tracking (Pillar 5)
LOG_LEVEL=info
# Optional: paste your Sentry DSN to enable async server error reporting
SENTRY_DSN=

# Google Maps API Keys (HTTP referrer restricted to https://gis.yourdomain.edu.ph/*)
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_PROD_BROWSER_KEY
GOOGLE_MAPS_API_KEY=REPLACE_WITH_PROD_SERVER_KEY
