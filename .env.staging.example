# ==============================================================================
# Studentmapping GIS — Staging Environment Template
# Copy to `.env.staging` on your staging host. NEVER commit real secrets.
# ==============================================================================

NODE_ENV=staging
PORT=5000

# MySQL 8.4+ Staging Database
MYSQL_URL=mysql://studentmapping_staging:CHANGE_ME@staging-db-host:3306/student_mapping_staging
DATABASE_URL=mysql://studentmapping_staging:CHANGE_ME@staging-db-host:3306/student_mapping_staging

# Docker Compose MySQL credentials (if using docker-compose.yml)
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=student_mapping_staging
MYSQL_USER=studentmapping_staging
MYSQL_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# Redis (optional until Pillar 3/4 activation)
REDIS_URL=redis://redis:6379

# Required Security Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_STAGING_SESSION_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STAGING_ENCRYPTION_KEY

# Strict CORS/CSRF Origin Allowlist
CORS_ORIGIN=https://staging-gis.yourdomain.edu.ph

# Must ALWAYS be false outside local development
ALLOW_DEV_AUTO_ADMIN=false

# Admin seed (only when running `npx tsx server/seedAdmin.ts`)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Google Maps API Keys (restrict by domain in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_STAGING_BROWSER_KEY
GOOGLE_MAPS_API_KEY=REPLACE_WITH_STAGING_SERVER_KEY
