# ==============================================================================
# Studentmapping GIS — Environment Configuration Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==============================================================================

# Runtime environment: development | staging | production
NODE_ENV=development
PORT=5000

# Primary MySQL (8.x / latest) connection string
MYSQL_URL=mysql://root:CHANGE_ME@localhost:3306/student_mapping
# Optional alias fallback (keep identical to MYSQL_URL if used by tooling)
DATABASE_URL=mysql://root:CHANGE_ME@localhost:3306/student_mapping

# Security Secrets (REQUIRED in staging/production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_HEX_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_32_BYTE_KEY

# Comma-separated list of allowed frontend origins for CORS & CSRF checks
# Example: http://localhost:5000,https://gis.yourdomain.edu.ph
CORS_ORIGIN=http://localhost:5000

# Development-only flag (NEVER set true in production). Defaults to false.
ALLOW_DEV_AUTO_ADMIN=false

# Initial admin seed credentials (used only by `npx tsx server/seedAdmin.ts`)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Optional Google Maps API Keys (do not commit real keys; restrict by HTTP referrer in GCP)
# Vite only exposes variables prefixed with VITE_ to frontend code.
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_BROWSER_KEY
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_SERVER_KEY
